$("setpw").onclick=async()=>{
  const pw=$("np").value;if(pw.length<6)return toast("كلمة السر 6 أحرف على الأقل");
  try{const u=await raw("/auth/v1/user",{method:"PUT",body:{password:pw}});SES.user=u;saveSes();REC=false;$("np").value="";applyAuth();loadAll();toast("تم تغيير كلمة السر ✔")}catch(x){toast(x.message)}
};
$("delacc").onclick=async()=>{
  if(!confirm("هل تريد حذف حسابك وكل بياناتك نهائياً؟"))return;
  const w=prompt("للتأكيد اكتب كلمة: حذف");if(!w||w.trim()!=="حذف")return toast("تم الإلغاء");
  try{await api("/rest/v1/rpc/delete_my_account",{method:"POST",body:{}});SES=null;saveSes();OFF=[];SUBS=[];applyAuth();loadAll();toast("تم حذف حسابك ✔")}
  catch(x){toast("تعذر الحذف: "+x.message)}
};

$("save").onclick=async()=>{
  const t=$("ft").value.trim(),n=$("fn").value.trim(),ph=$("fph").value.trim(),d=$("fd").value.trim();
  if(!t||!n||!d)return toast("املأ العنوان والاسم والوصف");
  if(!okPh(ph))return toast("رقم الهاتف غير صحيح (مثال: 0555123456)");
  $("save").disabled=true;
  try{await api("/rest/v1/listings",{method:"POST",body:{title:t,name:n,category:$("fc").value,wilaya:$("fw").value,price:+$("fp").value||0,price_type:$("ft2").value,phone:ph,description:d,origin:$("fo").value,...(ADDPOS||{})}});
    ["ft","fn","fp","fph","fd"].forEach(i=>$(i).value="");ADDPOS=null;$("fgpsOut").textContent="";cat="";WF="";$("wf").value="";go("home");toast("تم النشر ✔")}
  catch(x){toast(x.message);if(/اشتراك/.test(x.message)){go("mine");setTimeout(()=>{const m=$("memBox");if(m)m.scrollIntoView()},400)}}
  $("save").disabled=false;
};
$("rsave").onclick=async()=>{
  const t=$("rt").value.trim(),ph=$("rph").value.trim();
  if(!t)return toast("اكتب ماذا تحتاج");if(!okPh(ph))return toast("رقم الهاتف غير صحيح");
  $("rsave").disabled=true;
  try{await api("/rest/v1/requests",{method:"POST",body:{title:t,category:$("rc").value,wilaya:$("rw").value,budget:+$("rb").value||0,phone:ph}});
    ["rt","rb","rph"].forEach(i=>$(i).value="");toast("تم نشر طلبك ✔");loadAll()}
  catch(x){toast(x.message)}
  $("rsave").disabled=false;
};
$("aucNew").onclick=()=>{if(!SES){toast("سجّل الدخول لإنشاء مزاد");return go("mine")}aucForm()};
$("aucList").onclick=async e=>{
  const b=e.target.closest("[data-bid]"),c=e.target.closest("[data-acancel]"),rp=e.target.closest("[data-areport]");if(rp)return aucReport(rp.dataset.areport);
  if(b){if(!SES){toast("سجّل الدخول للمزايدة");return go("mine")}const a=AUC.find(x=>x.id===b.dataset.bid);if(a)bidForm(a)}
  if(c&&confirm("إلغاء هذا المزاد؟")){try{await api("/rest/v1/rpc/cancel_auction",{method:"POST",body:{p_id:c.dataset.acancel}});toast("تم الإلغاء");loadAuctions()}catch(x){toast(x.message)}}
};
setInterval(()=>{const pg=$("p-auction");if(pg&&pg.classList.contains("on"))renderAuctions()},30000);
$("fgps").onclick=()=>getPos((la,lo)=>{ADDPOS={lat:+la.toFixed(2),lng:+lo.toFixed(2)};$("fw").value=WIL[nearestW(la,lo)];$("fgpsOut").textContent="✔ تم تحديد موقع تقريبي (دقة نحو كيلومتر، لحماية خصوصيتك لا نحفظ عنوانك الدقيق). الولاية: "+short(WIL[nearestW(la,lo)])});
$("lo").onclick=()=>{LO=!LO;$("lo").style.background=LO?"var(--a)":"";render()};
$("loc").onclick=()=>{
  if(UP){UP=null;$("loc").style.background="";$("loc").textContent="📍 موقعي";render();return toast("أُلغي الترتيب حسب الموقع")}
  getPos((la,lo)=>{UP={la,lo};WF="";$("wf").value="";$("loc").style.background="var(--a)";$("loc").textContent="📍 الأقرب";render();toast("رُتّبت الإعلانات من الأقرب إليك — ولايتك: "+short(WIL[nearestW(la,lo)]))});
};

