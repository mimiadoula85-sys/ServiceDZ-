function renderEconomy(){
  const l=L.filter(x=>!EW||x.wilaya===EW),r=R.filter(x=>!EW||x.wilaya===EW);
  const loc=l.length?Math.round(100*l.filter(x=>x.origin==="محلي").length/l.length):0;
  const pr=l.map(x=>+x.price).filter(x=>x>0).sort((a,b)=>a-b),med=pr.length?pr[Math.floor(pr.length/2)]:0;
  const done=OFF.filter(o=>o.received_at).length+QN.filter(o=>o.received_at).length;
  $("pulseMetrics").innerHTML=[
    `<div class="metric"><b>${l.length}</b><span>عروض متاحة</span></div>`,
    `<div class="metric"><b>${r.length}</b><span>طلبات منشورة</span></div>`,
    `<div class="metric"><b>${loc}%</b><span>من العروض منتج محلي</span></div>`,
    `<div class="metric"><b>${med?fmt(med):"—"}</b><span>وسيط الأسعار المعروضة</span></div>`,
    `<div class="metric"><b>${new Set(L.map(x=>x.wilaya).filter(Boolean)).size}</b><span>ولايات بها عروض</span></div>`,
    `<div class="metric"><b>${done}</b><span>صفقاتي المكتملة</span></div>`
  ].join("");
  const cats={};r.forEach(x=>{cats[x.category]=(cats[x.category]||0)+1});
  const top=Object.entries(cats).sort((a,b)=>b[1]-a[1]).slice(0,4);
  $("opportunities").innerHTML=top.length?top.map(([c,n])=>{const sup=l.filter(x=>x.category===c).length,gap=Math.max(0,n-sup);
    return `<div class="opportunity"><b>🔥 ${esc(c)}</b><div class="meta">طلبات: ${n} · عروض حالية: ${sup}</div><div class="st">${gap?`فرصة محتملة: الطلب أعلى من العرض بـ ${gap}`:"يوجد عرض حالي مناسب لهذه الفئة"}</div></div>`}).join(""):'<div class="empty">عندما تبدأ الطلبات بالوصول ستظهر هنا الفئات ذات الطلب المرتفع.</div>';
}
